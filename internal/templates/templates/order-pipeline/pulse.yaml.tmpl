project: {{.Project}}
region: us-east-1

functions:
  api:
{{- if eq .Lang "python"}}
    runtime: python3.12
    handler: src.api.handler
{{- else}}
    runtime: nodejs20.x
    handler: src/api.handler
{{- end}}
    codeDir: services/api
    timeout: 10
    memory: 256
    env:
      TABLE_NAME: orders
      QUEUE_NAME: order-events
  worker:
{{- if eq .Lang "python"}}
    runtime: python3.12
{{- else}}
    runtime: nodejs20.x
{{- end}}
    handler: handler.handle
    codeDir: services/worker
    timeout: 30
    env:
      TABLE_NAME: orders

triggers:
  - type: http
    method: POST
    path: /orders
    function: api
  - type: http
    method: GET
    path: /orders/{id}
    function: api
  - type: sqs
    queue: order-events
    function: worker
    batchSize: 10

resources:
  tables:
    orders:
      pk: id                 # partition key (shorthand: type defaults to S)
  queues:
    order-events:
      dlq: order-events-dlq
      maxReceiveCount: 3
      visibilityTimeout: 5   # short so local retries are snappy to watch
    order-events-dlq: {}
